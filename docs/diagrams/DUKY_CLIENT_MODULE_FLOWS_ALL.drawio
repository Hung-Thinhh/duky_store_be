          <mxGeometry x="60" y="40" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="seo-page" value="Page cần SEO&#xa;- Homepage&#xa;- Product list/category&#xa;- Product detail&#xa;- Blog detail&#xa;- Static pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="260" height="140" as="geometry" />
