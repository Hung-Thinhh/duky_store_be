        </mxCell>
        <mxCell id="seo-api" value="API dùng&#xa;- GET /api/v1/products/:slug&#xa;- GET /api/v1/homepage&#xa;- GET /api/v1/blog/:slug&#xa;- GET /api/v1/sitemap.xml&#xa;- GET /api/v1/robots.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="115" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="seo-render" value="Render SEO&#xa;- Meta title/description&#xa;- OG tags&#xa;- Canonical URL&#xa;- Product schema basic&#xa;- Không block UI nếu thiếu meta optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="120" width="300" height="160" as="geometry" />
