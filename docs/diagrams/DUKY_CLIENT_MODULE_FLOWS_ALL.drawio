          <mxGeometry x="780" y="420" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="seo-note" value="Ghi chú&#xa;SEO là P1. Không nên làm chậm flow mua hàng P0. Nếu thiếu meta từ BE, FE dùng fallback từ tên sản phẩm/trang." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=14;" vertex="1" parent="1">
