<mxfile host="app.diagrams.net">
  <diagram name="Static Pages">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="STATIC PAGE MODULE&#xa;&#xa;Scope: contact page, policy pages, shop info. MVP Plus, khong duoc block checkout.&#xa;&#xa;CONTACT PAGE FLOW&#xa;1. User vao /contact&#xa;2. FE call GET /api/v1/settings/public&#xa;3. Render hotline, address, Zalo, Facebook, Google Maps&#xa;4. Optional contact form if API exists later&#xa;&#xa;POLICY PAGE FLOW&#xa;1. User vao /policies/shipping, /policies/warranty, /policies/return, /policies/privacy&#xa;2. FE loads page content from API if available&#xa;3. If API not available -> render static temporary content&#xa;4. Footer links route to policy pages&#xa;&#xa;API USED&#xa;- GET /api/v1/settings/public&#xa;- Settings/Page APIs if available&#xa;&#xa;DATA NEEDED&#xa;- shopName, hotline, address&#xa;- zaloUrl, facebookUrl, mapUrl&#xa;- bank account optional if payment info reused&#xa;- policy title/content if CMS/page API exists&#xa;&#xa;FALLBACK RULE&#xa;- Contact page can render from settings only&#xa;- Policy pages can use static content temporarily&#xa;- Missing social/map links should hide that section&#xa;&#xa;DONE WHEN&#xa;- Footer policy/contact links work&#xa;- Contact information visible&#xa;- Policy pages readable and mobile friendly&#xa;- No dependency blocks purchase MVP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fee7;strokeColor=#4d7c0f;fontSize=16;align=left;verticalAlign=top;spacing=24;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="1440" height="860" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

