PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,https://admin-store.duky.qzz.io
PUBLIC_SITE_URL=https://dukystore.com

POSTGRES_DB=duky_store
POSTGRES_USER=duky
POSTGRES_PASSWORD=duky_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://duky:duky_password@localhost:5432/duky_store?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or use a managed Redis URL instead of REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
# REDIS_URL=redis://default:password@host:6379

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Duky Store <no-reply@dukystore.local>"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=client_id_1.apps.googleusercontent.com,client_id_2.apps.googleusercontent.com
# Optional: use a different Google OAuth client for customer storefront login.
# GOOGLE_CUSTOMER_CLIENT_IDS=customer_client_id.apps.googleusercontent.com

# Media storage: LOCAL or R2. LOCAL keeps uploads under uploads/media.
MEDIA_STORAGE_PROVIDER=LOCAL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_REGION=auto
R2_PREFIX=media

BLOG_AI_BASE_URL=https://llm.chiasegpu.vn/v1
BLOG_AI_MODEL=gx/gpt-5.5
BLOG_AI_API_KEY=

# Google Search Console URL Inspection API
# Use a URL-prefix property with trailing slash or a domain property.
GSC_SITE_URL=https://dukystore.com/
GSC_PUBLIC_BASE_URL=https://dukystore.com/
# Preferred: store the service account JSON as an environment secret, not as a file.
GSC_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative if your secret manager supports multiline JSON safely.
GSC_SERVICE_ACCOUNT_JSON=
# Alternative split-field mode. GSC_PRIVATE_KEY can contain escaped \n.
GSC_PROJECT_ID=
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# Local fallback only. Do not commit the JSON key file.
# GSC_SERVICE_ACCOUNT_KEY_FILE=.gsc/dukystore-search-console.json
GSC_INPUT_FILE=docs/seo/gsc-exports/page-indexing.csv
GSC_OUTPUT_FILE=docs/seo/gsc-results/url-inspection-results.json
GSC_INSPECTION_DELAY_MS=1200
GSC_LANGUAGE_CODE=vi
GSC_AUTO_SCAN_INCLUDE_LIVE_SITEMAP=true
GSC_STATIC_CANDIDATE_PATHS=/,/products,/blog,/collections/boot-nam,/collections/boot-nu,/collections/phu-kien,/collections/outfit

SEED_ADMIN_EMAIL=admin@dukystore.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_FULL_NAME=Duky Super Admin
