  status       JobStatus @default(WAITING)
  attempts     Int       @default(0)
  payload      Json?
  result       Json?
  errorMessage String?
  runAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queueName, status])
  @@index([jobId])
  @@map("background_jobs")
}

model KeywordPlan {
  id         String   @id @default(cuid())
  keyword    String   @unique
  cluster    String
  intent     String
  priority   String
  status     String
  owner      String
  targetPath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("keyword_plans")
}

model CustomerPasswordReset {
  id        String   @id @default(cuid())
  email     String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("customer_password_resets")
}
